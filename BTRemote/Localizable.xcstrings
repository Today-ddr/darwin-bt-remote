    "device.remove_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will stop receiving your input and will not regain control on its own. Bluetooth can only be disconnected from the other device, so it may still show as connected there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将不再接收你的输入，也不会自动恢复控制。蓝牙断开只能由对方设备发起，因此对方设备上可能仍显示为已连接。"
          }
        }
      }
