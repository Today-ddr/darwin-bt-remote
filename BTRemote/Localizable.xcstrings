      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Direct Input to use the device with your current keyboard and mouse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用“直接输入”，即可用当前的键盘和鼠标操作该设备。"
          }
        }
      }
    },
