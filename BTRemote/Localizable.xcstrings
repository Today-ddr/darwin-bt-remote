            "state": "translated",
            "value": "✓ 表示设备已激活并已订阅。"
          }
        }
      }
    },
    "setup.bluetooth_off_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth must be on to proceed. Enable it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须开启蓝牙才能继续。请开启后重试。"
          }
        }
      }
    },
    "setup.bluetooth_off_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On Bluetooth"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启蓝牙"
          }
        }
      }
    },
    "setup.classic_guide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth Classic Guide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙经典模式指南"
          }
        }
      }
    },
    "setup.classic_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Paired Devices, click \"Pair New Device\", or pair from System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“已配对设备”下点按“配对新设备”，或从“系统设置”中配对。"
          }
        }
      }
    },
    "setup.classic_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the device you want to use in the window that appears. Make sure the target device is discoverable by going to the Bluetooth screen on the target device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在弹出的窗口中选择要使用的设备。请确保目标设备处于可被发现状态（前往目标设备的蓝牙界面）。"
          }
        }
      }
    },
    "setup.classic_step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select \"Connect\" to establish a connection. You may need to wait a few seconds before it activates. Occasionally you may need to try again by clicking \"Connect\" a second time to activate a stable connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“连接”建立连接。可能需要等待几秒才会生效。有时需要再次点按“连接”，才能建立稳定的连接。"
          }
        }
      }
    },
    "setup.classic_troubleshooting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the device still does not respond, remove the pairing on both this device and the target device, then pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果设备仍无响应，请在本机与目标设备上分别移除配对，然后重新配对。"
          }
        }
      }
    },
    "setup.advertised_name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertised Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广播名称"
          }
        }
      }
    },
    "setup.advertised_name_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name other devices see. For best compatibility, keep it to 8 characters or fewer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他设备看到的名称。为获得最佳兼容性，请保持在 8 个字符以内。"
          }
        }
      }
    },
    "setup.device_name_limitation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to platform limitations, the name of the target device cannot be displayed unless it has previously been paired with this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受平台限制，除非目标设备此前已与本机配对，否则无法显示其名称。"
          }
        }
      }
    },
    "setup.connect_from_target_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect from the target device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从目标设备发起连接"
          }
        }
      }
    },
    "setup.connect_from_this_app": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect from this application"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本应用发起连接"
          }
        }
      }
    },
    "setup.find_guide_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can find this guide at the top of the \"Setup\" tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在“引导”标签页顶部找到本指南。"
          }
        }
      }
    },
    "setup.from_app": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple devices (same Apple Account)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 设备（同一 Apple 账户）"
          }
        }
      }
    },
    "setup.from_app_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Scan\" under Devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“设备”下的“扫描”。"
          }
        }
      }
    },
    "setup.from_app_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the device to connect. You may also identify a device by using the information button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按要连接的设备。你也可以通过信息按钮来识别设备。"
          }
        }
      }
    },
    "setup.from_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All other devices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有其他设备"
          }
        }
      }
    },
    "setup.from_device_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensure this application is open and advertising. You can check this in \"Status\" within the \"Setup\" tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保本应用已打开并正在广播。可在“引导”标签页的“状态”中查看。"
          }
        }
      }
    },
    "setup.from_device_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the target device, open Bluetooth settings and pair with \"%@\" or this device's Bluetooth name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在目标设备上打开蓝牙设置，与“%@”或本机的蓝牙名称配对。"
          }
        }
      }
    },
    "setup.from_device_step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select \"Pair\" or \"Connect\" on the target device first, then confirm with \"Pair\" on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在目标设备上选择“配对”或“连接”，然后在本机点按“配对”确认。"
          }
        }
      }
    },
    "setup.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助"
          }
        }
      }
    },
    "setup.icloud_paired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices paired over iCloud will not show up in iOS Settings > Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 iCloud 配对的设备不会显示在 iOS“设置 > 蓝牙”中。"
          }
        }
      }
    },
    "setup.le_guide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth Low Energy Guide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低功耗蓝牙指南"
          }
        }
      }
    },
    "setup.troubleshooting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If there is no response on the target, forget the pairing on both devices in their respective Settings, turn Bluetooth off and on, and then initiate pairing again from the target device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果目标设备无响应，请在两台设备各自的设置中“忽略此设备”，关闭再开启蓝牙，然后从目标设备重新发起配对。"
          }
        }
      }
    },
    "setup.video_instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video Instructions"
          }
        },
