    "direct_input.capture_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not capture input. Allow BT Remote in Accessibility and Input Monitoring, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法捕获输入。请在“辅助功能”和“输入监控”中允许 BT Remote，然后重试。"
          }
        }
      }
    },
