    "settings.force_service_changed_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force a connected device to re-detect services as a workaround for stale GATT cache. Required for initial pairing with Android devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制已连接的设备重新检测服务，以解决 GATT 缓存过期的问题。与 Android 设备首次配对时需要。"
          }
        }
      }
    },
    "settings.reset": {
