    "setup.advertised_name_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name other devices see. For best compatibility, keep it to 8 characters or fewer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他设备看到的名称。为获得最佳兼容性，请保持在 8 个字符以内。"
          }
        }
      }
    },
    "setup.device_name_limitation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to platform limitations, the name of the target device cannot be displayed unless it has previously been paired with this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受平台限制，除非目标设备此前已与本机配对，否则无法显示其名称。"
          }
        }
      }
    },
    "setup.connect_from_target_device": {
