      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct Input needs Accessibility access to capture your current keyboard and mouse. Allow this application in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“直接输入”需要“辅助功能”权限才能捕获当前的键盘和鼠标。请在“系统设置”中允许此应用。"
          }
        }
      }
    },
