    "settings.auto_advertise_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertise automatically when the app opens. When off, nothing is advertised until you tap Start Advertising in Setup, so paired devices cannot reconnect on their own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用打开时自动作为蓝牙设备广播。关闭后，在你于点按“连接”标签页中的“开始广播”之前，应用不会广播任何内容，已配对的设备也无法自行重连。"
          }
        }
      }
    },
    "settings.connection": {
      "extractionState": "manual",
